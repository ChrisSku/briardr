# Versions scripts/setup-linux.sh installs on a Linux server. Bun's version comes from mise.toml.
# The setup never upgrades these by itself: an installed Herdr of another version is left alone and
# reported. Change a pin only after testing Briardr with it, and update the checksums from the release.
HERDR_VERSION=0.9.3
# SHA-256 of https://github.com/herdrdev/herdr/releases/download/v$HERDR_VERSION/herdr-linux-<arch>
HERDR_SHA256_X86_64=18a8dc65f1c2fa485884344356dea1cfd911c6f06cf46fa78e193f4087f4dba7
HERDR_SHA256_AARCH64=4de7aa3e25678812e92960de64f7c2aaa1bca1f0f80a3c5e559837e231e1f5c0
# Caddy, when its apt repository (dl.cloudsmith.io) can't be used: the release .deb from GitHub.
# With the repository, apt keeps Caddy updated; with this pin, update it here.
CADDY_VERSION=2.11.7
# SHA-256 of https://github.com/caddyserver/caddy/releases/download/v$CADDY_VERSION/caddy_${CADDY_VERSION}_linux_<arch>.deb
CADDY_SHA256_AMD64=a22b914ffd1958da42bc7ab13b7b62c6100634e0798ab594891d2d61d53ba749
CADDY_SHA256_ARM64=ca8ae5a50439642d7672344b4ec64e47cbddf81beb5da302420a78522eb5a47e
# Ubuntu LTS releases the setup is tested on.
SUPPORTED_UBUNTU="24.04 26.04"
