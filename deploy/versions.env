# Versions Briardr installs: Herdr (`briardr setup` on macOS and Linux, compiled into the server, and
# scripts/setup-linux.sh) and Caddy and the Ubuntu releases (scripts/setup-linux.sh). Bun's version comes
# from mise.toml. Nothing upgrades these by itself: an installed Herdr is left alone, and reported when it
# isn't a tested version. Change a pin only after testing Briardr with it, and update the checksums from
# the release (docs/development.md#test-another-herdr-version).
HERDR_VERSION=0.9.5
# Every Herdr version both test suites passed with; the pin above is one of them.
HERDR_TESTED="0.9.3 0.9.4 0.9.5"
# SHA-256 of https://github.com/herdrdev/herdr/releases/download/v$HERDR_VERSION/herdr-<os>-<arch>
HERDR_SHA256_LINUX_X86_64=14d9e8bc8b4a9e0118d77c32266f76d461f09b40342eb23752960bd89f59929d
HERDR_SHA256_LINUX_AARCH64=17d7536f2da50859523680ef279dffcac8e4a235f4e46fe8da6c2ec44141897c
HERDR_SHA256_MACOS_X86_64=5fb0a908ec7f6745e3e245738b06bfad56c46391c391ab3c0955fbead01f1369
HERDR_SHA256_MACOS_AARCH64=fb77c2232a05a8035421382c894392f4174e4e38a18e48af3dd0290157c3a7e2
# Caddy, when its apt repository (dl.cloudsmith.io) can't be used: the release .deb from GitHub.
# With the repository, apt keeps Caddy updated; with this pin, update it here.
CADDY_VERSION=2.11.7
# SHA-256 of https://github.com/caddyserver/caddy/releases/download/v$CADDY_VERSION/caddy_${CADDY_VERSION}_linux_<arch>.deb
CADDY_SHA256_AMD64=a22b914ffd1958da42bc7ab13b7b62c6100634e0798ab594891d2d61d53ba749
CADDY_SHA256_ARM64=ca8ae5a50439642d7672344b4ec64e47cbddf81beb5da302420a78522eb5a47e
# Ubuntu LTS releases the setup is tested on.
SUPPORTED_UBUNTU="24.04 26.04"
