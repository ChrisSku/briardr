{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [],
    // The built-in plugins (../plugins/<id>) import @briardr/sdk like any plugin.
    "paths": {
      "@briardr/sdk": ["./src/sdk/index.ts"],
      "@briardr/sdk/markdown": ["./src/sdk/markdown.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../plugins/*/src/**/*.ts", "../plugins/*/src/**/*.svelte"],
  // The template is checked as what `briardr create plugin` makes (test/create-plugin.test.ts).
  "exclude": ["src/sdk/runtime", "../plugins/template"]
}
